# ---- LLM (DeepSeek) - bắt buộc cho cả 2 cách thực hiện
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=180

# ---- Google Cloud Vision - cho cách "Google Cloud Vision + LLM"
# Lấy key: Google Cloud Console -> bật Billing -> bật Cloud Vision API -> Credentials -> API key (bắt đầu bằng AIza)
GOOGLE_VISION_API_KEY=
VISION_TIMEOUT=60

# ---- OCR local
# Số luồng CPU (0 = tự chọn: một nửa số luồng, tối đa 4). Đặt bằng số nhân thật của máy chạy.
OCR_THREADS=0
# oneDNN cho Paddle: thường nhanh hơn nhiều, nhưng có CPU (nhân E của Intel) bị chậm -> đặt false
OCR_ENABLE_MKLDNN=true
# Cạnh dài ảnh đưa vào detection: 1600 chính xác (~8.7s) | 1280 (~7s) | 960 nhanh (~5s, kém hơn ~4.6 điểm)
OCR_DET_LIMIT_SIDE=1600
# Thư mục model VietOCR (tự tải lần đầu). Có thể trỏ tới thư mục models của project OCR để khỏi tải lại.
MODELS_DIR=

# ---- Dữ liệu (mặc định: thư mục data/ của project)
# DATA_DIR=
# DB_PATH=
# UPLOADS_DIR=

# ---- Lựa chọn mặc định trên giao diện
# vision | local
DEFAULT_METHOD=vision
# food | drug
DEFAULT_PROFILE=food
